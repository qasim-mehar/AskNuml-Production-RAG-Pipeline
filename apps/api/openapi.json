{"openapi":"3.1.0","info":{"title":"uni-rag API","version":"v1"},"paths":{"/health/live":{"get":{"tags":["health"],"summary":"Liveness probe","description":"Report that the process is up, without consulting any dependency.","operationId":"live_health_live_get","responses":{"200":{"description":"Successful Response","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LiveStatus"}}}}}}},"/health/ready":{"get":{"tags":["health"],"summary":"Readiness probe","description":"Report readiness after checking the injected ports' fake health.","operationId":"ready_health_ready_get","responses":{"200":{"description":"Successful Response","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReadyStatus"}}}},"503":{"description":"Injected ports are not ready","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorBody"}}}}}}},"/api/v1/query":{"post":{"tags":["query"],"summary":"Return a cited answer","description":"Return the exact cited Answer for a query (or an explicit abstention).","operationId":"query_api_v1_query_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Query"}}},"required":true},"responses":{"200":{"description":"Successful Response","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Answer"}}}},"401":{"description":"Missing or invalid API key","headers":{"x-request-id":{"description":"Trace id: echoes