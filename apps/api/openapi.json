me; Urdu accepted","title":"Department"},"description":"Department name; Urdu accepted"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":20,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}}],"responses":{"200":{"description":"Matching records; empty list on no match","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaperSearchResult"}}},"headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}}},"401":{"description":"Missing or invalid API key","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorBody"}}}},"422":{"description":"Typed validation error","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorBody"}}}},"429":{"description":"Rate limit exceeded","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorBody"}}}},"503":{"description":"Upstream papers provider failure","headers":{"x-request-id":{"description":"Trace id: echoes the caller's X-Trace-Id or mints a fresh id (L10).","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorBody"}}}}}}}},"components":{"schemas":{"Answer":{"properties":{"answer_id":{"type":"string","title":"Answer Id"},"query_id":{"type":"string","title":"Query Id"},"text":{"type":"string","title":"Text"},"citations":{"items":{"$ref":"#/components/schemas/Citation"},"type":"array","title":"Citations"},"images":{"items":{"$ref":"#/components/schemas/ImageRef"},"type":"array","title":"Images"},"abstained":{"type":"boolean","title":"Abstained","default":false},"confidence":{"type":"number","title":"Confidence","default":0.0},"language":{"$ref":"#/components/schemas/Language","default":"en"},"next_step":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Next Step"},"abstention_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Abstention Reason"}},"additionalProperties":false,"type":"object","required":["answer_id","query_id","text"],"title":"Answer","description":"A cited answer; ``abstained`` is True when evidence is insufficient."},"Citation":{"properties":{"chunk_id":{"type":"string","title":"Chunk Id"},"doc_id":{"type":"string","title":"Doc Id"},"source_url":{"type":"string","title":"Source Url"},"snippet":{"type":"string","title":"Snippet"},"page":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Page"},"score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Score"},"last_crawled":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Last Crawled"}},"additionalProperties":false,"type":"object","required":["chunk_id","doc_id","source_url","snippet"],"title":"Citation","description":"A pointer from an answer span back to an indexed chunk."},"ErrorBody":{"properties":{"code":{"type":"string","title":"Code"},"message":{"type":"string","title":"Message"},"details":{"additionalProperties":true,"type":"object","title":"Details"}},"additionalProperties":false,"type":"object","required":["code","message"],"title":"ErrorBody","description":"Machine-readable error envelope for every non-2xx response."},"FeedbackRequest":{"properties":{"answer_id":{"type":"string","title":"Answer Id"},"sentiment":{"type":"string","enum":["positive","negative"],"title":"Sentiment"},"reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Reason"},"query_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Query Id"}},"additionalProperties":false,"type":"object","required":["answer_id","sentiment"],"title":"FeedbackRequest","description":"ADR 0009 local-only feedback payload; unknown fields are rejected."},"ImageRef":{"properties":{"ref_id":{"type":"string","title":"Ref Id"},"source_url":{"type":"string","title":"Source Url"},"page":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Page"},"caption":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Caption"},"mime_type":{"type":"string","title":"Mime Type","default":"image/png"},"image_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Image Url"}},"additionalProperties":false,"type":"object","required":["ref_id","source_url"],"title":"ImageRef","description":"A reference to a stored page/screenshot image (object-store key)."},"Language":{"type":"string","enum":["en","ur","roman_urdu"],"title":"Language","description":"Supported query/document languages (L7)."},"LiveStatus":{"properties":{"status":{"type":"string","const":"ok","title":"Status"},"service":{"type":"string","title":"Service"}},"additionalProperties":false,"type":"object","required":["status","service"],"title":"LiveStatus","description":"Liveness response: no dependency checks."},"PaperRecord":{"properties":{"question_id":{"type":"string","title":"Question Id"},"doc_id":{"type":"string","title":"Doc Id"},"source_url":{"type":"string","title":"Source Url"},"page":{"type":"integer","title":"Page"},"question_number":{"type":"integer","title":"Question Number"},"text":{"type":"string","title":"Text"},"year":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Year"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Subject"},"options":{"items":{"type":"string"},"type":"array","title":"Options"},"image_ref":{"anyOf":[{"$ref":"#/components/schemas/ImageRef"},{"type":"null"}]},"course_code":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Course Code"},"term":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Term"},"exam_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Exam Type"},"department":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Department"},"last_crawled":{"type":"string","format":"date-time","title":"Last Crawled"}},"additionalProperties":false,"type":"object","required":["question_id","doc_id","source_url","page","question_number","text","last_crawled"],"title":"PaperRecord","description":"A segmented paper question plus its source's frozen crawl time (L5).\n\n``PastPaperQuestion`` stops at core ADR 0007's finder fields; ``last_crawled``\nis carried here so every returned record is traceable without a core change."},"PaperSearchResult":{"properties":{"results":{"items":{"$ref":"#/components/schemas/PaperRecord"},"type":"array","title":"Results"}},"additionalProperties":false,"type":"object","required":["results"],"title":"PaperSearchResult","description":"Finder response; the ``results`` key matches Lane H's strict mirror."},"Query":{"properties":{"query_id":{"type":"string","title":"Query Id"},"text":{"type":"string","title":"Text"},"language":{"$ref":"#/components/schemas/Language"},"top_k":{"type":"integer","title":"Top K","default":10},"filters":{"additionalProperties":{"type":"string"},"type":"object","title":"Filters"}},"additionalProperties":false,"type":"object","required":["query_id","text","language"],"title":"Query","description":"A student question (English, Urdu, or Roman Urdu)."},"ReadyStatus":{"properties":{"status":{"type":"string","const":"ready","title":"Status"},"service":{"type":"string","title":"Service"}},"additionalProperties":false,"type":"object","required":["status","service"],"title":"ReadyStatus","description":"Readiness response: injected ports were checked."}},"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"X-API-Key"}}}}