# Copy to .env and fill real values. All settings are read only by
# uni_rag_core.config.settings (L8). Prefix: UNI_RAG_.
# Local development example only: the values below are throwaway dev defaults,
# not secrets. Replace credentials before using this outside local development.

UNI_RAG_APP_NAME=uni-rag
UNI_RAG_ENVIRONMENT=local
UNI_RAG_LOG_LEVEL=INFO

# Required — foundation fails fast without these.
UNI_RAG_QDRANT_URL=http://localhost:6333
UNI_RAG_POSTGRES_DSN=postgresql+psycopg://uni_rag:uni_rag@localhost:5432/uni_rag
UNI_RAG_MINIO_ENDPOINT=http://localhost:9000

# Optional infrastructure.
UNI_RAG_MINIO_ACCESS_KEY=minioadmin
UNI_RAG_MINIO_SECRET_KEY=minioadmin
UNI_RAG_MINIO_BUCKET=uni-rag
UNI_RAG_LANGFUSE_HOST=http://localhost:3000

# Retrieval tuning (measured in Lane F, never guessed here).
UNI_RAG_EMBEDDING_DIMENSION=16
UNI_RAG_DEFAULT_TOP_K=10
UNI_RAG_ABSTENTION_THRESHOLD=0.35
